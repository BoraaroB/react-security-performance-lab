# Run `node scripts/setup-env.mjs` (from the repo root) to create .env with generated secrets. Never commit .env.
NODE_ENV=development
PORT=4000
# Optional: fatal | error | warn | info | debug | trace | silent (default: debug in development, info in production)
# LOG_LEVEL=debug
# Optional: true | false (default: true in development, false in production)
# ENABLE_DEMO_ROUTES=true
# Optional: true | false. Creates admin@example.com and user@example.com with PUBLIC passwords
# (default: true in development, false in production)
# SEED_DEMO_ACCOUNTS=true
# Optional: comma-separated exact origins, no trailing slash (default: http://localhost:5173 in development, none in production)
# CORS_ORIGINS=http://localhost:5173
# Optional: reverse proxies in front of the app, as a hop count or a comma-separated list of proxy IPs/CIDRs
# (default: 0 = no proxy). Never "true": clients could fake their IP and bypass the rate limits.
# TRUST_PROXY=1
# Required: 32 random bytes in base64, used to encrypt sensitive fields (AES-256-GCM). Leave it empty here and run
# `node scripts/setup-env.mjs` to generate it. Never reuse a key between environments; losing it loses the encrypted data.
DATA_ENCRYPTION_KEY=
